# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Backend & AI Service URL
BACKEND_API_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000

# Model Provider Backend Selection ('hosted_api' or 'local')
MODEL_BACKEND=hosted_api

# Hosted Qwen API Configuration (OpenRouter)
QWEN_API_BASE=https://openrouter.ai/api/v1
QWEN_MODEL_NAME=qwen/qwen2.5-vl-72b-instruct
QWEN_API_KEY=

# Inference Parameters
MAX_NEW_TOKENS=4096
TEMPERATURE=0.1
REQUEST_TIMEOUT=180

# Local Model Path (Only used if MODEL_BACKEND=local on GPU infrastructure)
QWEN_MODEL_PATH=
DEVICE=cuda
TORCH_DTYPE=bfloat16
