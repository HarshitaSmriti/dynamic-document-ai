# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Backend & AI Service URL
BACKEND_API_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000

# Model Provider Backend Selection ('local' or 'hosted_api')
# 'local' runs the official Apache-2.0 licensed Qwen2.5-VL model via Hugging Face Transformers
MODEL_BACKEND=local

# Local Qwen2.5-VL Model Configuration (Apache-2.0)
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_DEVICE=auto
QWEN_TORCH_DTYPE=auto
QWEN_MAX_NEW_TOKENS=1024
QWEN_TEMPERATURE=0.0
REQUEST_TIMEOUT=180

# Optional Hugging Face Cache Location (defaults to ~/.cache/huggingface/hub)
# HF_HOME=/path/to/cache

# Optional Self-Hosted OpenAI-Compatible Vision Endpoint (vLLM / Ollama / local inference node)
# Only active when MODEL_BACKEND=hosted_api
# QWEN_API_BASE=http://localhost:8000/v1
# QWEN_API_KEY=
